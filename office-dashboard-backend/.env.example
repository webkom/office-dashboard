# IMPORTANT - MUST BE PREFIXED w/ APP (prefix is removed when used)
APP_DEBUG=

# Which port backend should run on (5000 is usually problematic on mac)
APP_PORT=

# Set to True if you dont want to use actual endpoints
APP_MOCK_REQUESTS=

APP_MEMBERS_URI=
APP_MEMBERS_USER=
APP_MEMBERS_PASSWORD=

APP_PALANTIR_URI=
APP_PALANTIR_USER=
APP_PALANTIR_PASSWORD=

APP_GITHUB_API_TOKEN=

# The secret set on the organisation's pull request webhook
APP_GITHUB_WEBHOOK_SECRET=

APP_BRUS_URI=

# MQTT broker the office strip listens to; leave the host empty to not
# switch the lights from the backend
APP_MQTT_HOST=
# Encrypted (port 8883) by default; set APP_MQTT_TLS=false for plain 1883
APP_MQTT_TLS=
APP_MQTT_PORT=
APP_MQTT_USER=
APP_MQTT_PASSWORD=
# The strip's device topic, as set in WLED (Sync Interfaces → MQTT)
APP_WLED_MQTT_TOPIC=

# Read-only UptimeRobot key, and the monitors to show (ids joined with -)
APP_UPTIME_ROBOT_API_KEY=
APP_UPTIME_ROBOT_MONITORS=
